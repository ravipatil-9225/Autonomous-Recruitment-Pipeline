# ── Application ────────────────────────────────────────────────────────────────
APP_ENV=development                # development | staging | production
DEBUG=true
SECRET_KEY=CHANGE_ME_32_CHAR_SECRET_KEY_HERE   # min 32 chars

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://arp:arp_password@localhost:5432/arp_db
SYNC_DATABASE_URL=postgresql+psycopg2://arp:arp_password@localhost:5432/arp_db

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Object Storage (MinIO / S3) ───────────────────────────────────────────────
S3_ENDPOINT_URL=http://localhost:9000     # leave empty for real AWS S3
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RESUMES=arp-resumes
S3_REGION=us-east-1

# ── Vector DB (Chroma) ────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001

# ── MLflow ─────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5001

# ── Auth / Security ────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
# AES-256-GCM key for PII encryption (32 raw bytes → base64-encoded, 44 chars)
PII_ENCRYPTION_KEY=GENERATE_WITH__python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"

# ── Rate Limiting ──────────────────────────────────────────────────────────────
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_UPLOAD=10/minute

# ── AI / Phase 1 agents ────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_google_api_key_here
MATCH_THRESHOLD=0.65
MIN_EXPERIENCE_YEARS=2

# ── File Upload ────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx
